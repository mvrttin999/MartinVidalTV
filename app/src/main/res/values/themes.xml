<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MartInvidal" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.MartInvidal.Splash" parent="Theme.MartInvidal">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.MartInvidal.Player" parent="Theme.MartInvidal">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
